# API Configuration
# URL base da API do backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket direto no FastAPI (o proxy HTTP do Next.js não encaminha upgrade WS)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# WhatsApp comercial usado nos CTAs da landing pública (formato E.164 sem "+", ex: 5511987654321)
NEXT_PUBLIC_WHATSAPP_COMERCIAL=
