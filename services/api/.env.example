# Base do backend
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./agrosaas.db
# Enable only with a PostgreSQL runtime identity that has no elevated role,
# membership into an elevated/owning role, or ownership in the farms schema.
REQUIRE_RESTRICTED_RUNTIME_ROLE=false
# Development-only gradual migration: only login and notification routes
# use the restricted runtime/auth pools; all other routes keep DATABASE_URL.
RLS_DEV_ROUTE_SESSIONS_ENABLED=false
# Required when restricted runtime mode is enabled. Dedicated login with
# EXECUTE on farms.auth_login_material(text), not table access.
AUTHENTICATION_DATABASE_URL=
AUTHENTICATION_DATABASE_ROLE=deepfarms_auth
# Optional, required by the recommendation dispatcher process when enabled.
RECOMMENDATION_DISPATCHER_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
INTEGRATIONS_SECRET_KEY=change-me-too

# Recepção dos eventos assinados pela Plataforma TARA
BALANCA_WEBHOOK_SECRET=segredo-hmac-da-conta
# Preferido para múltiplas Contas: {"account_uuid":"segredo-hmac"}
BALANCA_WEBHOOK_ACCOUNT_SECRETS_JSON={}
BALANCA_WEBHOOK_MAX_SKEW_SECONDS=300

# Sankhya Gateway
SANKHYA_ENVIRONMENT=producao
SANKHYA_API_BASE_URL=https://gateway.sankhya.com.br
SANKHYA_AUTH_URL=https://gateway.sankhya.com.br/authenticate
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=

# DeepFarmIA (Multi-provider: auto | groq | gemini | anthropic | ollama)
IA_ENABLED=true
IA_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
