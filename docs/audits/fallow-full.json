            "fragment": "\"use client\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { apiFetch } from \"@/lib/api\";\nimport { ShoppingCart, Plus, ArrowLeft, Trash2, Package, History, Tag, CheckCircle2, User, Calendar, Store, Trophy, Clock3 } from \"lucide-react\";\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Badge } from \"@/components/ui/badge\";\nimport {\n    Table,\n    TableBody,\n    TableCell,\n    TableHead,\n    TableHeader,\n    TableRow,\n} from \"@/components/ui/table\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger, DialogFooter } from \"@/components/ui/dialog\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Label } from \"@/components/ui/label\";\nimport { useForm, Controller } from \"react-hook-form\";\nimport { toast } from \"sonner\";\nimport { useState } from \"react\";\nimport { useParams, useRouter } from \"next/navigation\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { format } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\nimport Link from \"next/link\";\n\ninterface ItemPedido {\n    id: string;\n    produto_id: string;\n    nome_produto: string;\n    quantidade_solicitada: number;\n    preco_estimado_unitario: number;\n}\n\ninterface Cotacao {\n    id: string;\n    fornecedor_id: string;\n    nome_fornecedor: string;\n    valor_total: number;\n    prazo_entrega_dias?: number;\n    condicoes_pagamento?: string;\n    selecionada: boolean;\n}\n\ninterface Pedido {\n    id: string;\n    data_pedido: string;\n    status: string;\n    observacoes?: string;\n}\n\nexport default function PedidoDetalhePage() {\n    const { id } = useParams();\n    const queryClient = useQueryClient();\n    const [isAddItemOpen, setIsAddItemOpen] = useState(false);\n    const [isAddCotacaoOpen, setIsAddCotacaoOpen] = useState(false);\n\n    // --- QUERIES ---\n    const { data: pedido, isLoading: loadingPedido } = useQuery<Pedido>({\n        queryKey: [\"pedido\", id],\n        queryFn: () => apiFetch(`/compras/pedidos/${id}`)\n    });\n\n    const { data: itens, isLoading: loadingItens } = useQuery<ItemPedido[]>({\n        queryKey: [\"pedido-itens\", id],\n        queryFn: () => apiFetch(`/compras/pedidos/${id}/itens`)\n    });\n\n    const { data: cotacoes, isLoading: loadingCotacoes } = useQuery<Cotacao[]>({\n        queryKey: [\"pedido-cotacoes\", id],\n        queryFn: () => apiFetch(`/compras/pedidos/${id}/cotacoes`)\n    });\n\n    const { data: produtos } = useQuery<any[]>({\n        queryKey: [\"cadastros-produtos\", \"compras\"],\n        queryFn: () => apiFetch(\"/cadastros/produtos?ativo=true&incluir_sistema=true\")\n    });\n\n    const { data: fornecedores } = useQuery<any[]>({\n        queryKey: [\"fornecedores\"],\n        queryFn: () => apiFetch(\"/compras/fornecedores\")\n    });\n\n    // --- MUTATIONS ---\n    const addItemMutation = useMutation({\n        mutationFn: (data: any) => apiFetch(`/compras/pedidos/${id}/itens`, {\n            method: \"POST\",\n            body: JSON.stringify(data)\n        }),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"pedido-itens\", id] });\n            toast.success(\"Item adicionado!\");\n            setIsAddItemOpen(false);\n            resetItem();\n        }\n    });\n\n    const addCotacaoMutation = useMutation({\n        mutationFn: (data: any) => apiFetch(`/compras/pedidos/${id}/cotacoes`, {\n            method: \"POST\",\n            body: JSON.stringify(data)\n        }),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"pedido-cotacoes\", id] });\n            queryClient.invalidateQueries({ queryKey: [\"pedido\", id] });\n            toast.success(\"Cotação registrada com sucesso!\");\n            setIsAddCotacaoOpen(false);\n            resetCotacao();\n        }\n    });\n\n    const selectCotacaoMutation = useMutation({\n        mutationFn: (cotacaoId: string) => apiFetch(`/compras/cotacoes/${cotacaoId}/selecionar`, {\n            method: \"POST\"\n        }),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"pedido-cotacoes\", id] });\n            queryClient.invalidateQueries({ queryKey: [\"pedido\", id] });\n            toast.success(\"Fornecedor selecionado e pedido aprovado!\");\n        }\n    });\n\n    // --- FORMS ---\n    const { register: regItem, handleSubmit: handleItemSubmit, control: controlItem, reset: resetItem } = useForm();\n    const { register: regCot, handleSubmit: handleCotSubmit, control: controlCot, reset: resetCotacao } = useForm();\n\n    const onAddItem = (data: any) => {\n        addItemMutation.mutate({\n            ...data,\n            quantidade_solicitada: parseFloat(data.quantidade_solicitada),\n            preco_estimado_unitario: parseFloat(data.preco_estimado_unitario || 0)\n        });\n    };\n\n    const onAddCotacao = (data: any) => {\n        addCotacaoMutation.mutate({\n            ...data,\n            valor_total: parseFloat(data.valor_total),\n            prazo_entrega_dias: parseInt(data.prazo_entrega_dias)\n        });\n    };\n\n    if (loadingPedido || loadingItens || loadingCotacoes) {\n        return <div className=\"p-8 space-y-6\"><Skeleton className=\"h-10 w-48\" /><Skeleton className=\"h-64 w-full\" /></div>;\n    }\n\n    if (!pedido) return <div>Pedido não encontrado.</div>;\n\n    return (\n        <div className=\"p-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500 max-w-7xl mx-auto w-full\">\n            {/* Header */}\n            <div className=\"flex items-center gap-4\">\n                <Button variant=\"outline\" size=\"icon\">\n                    <Link href=\"/operacional/compras\">\n                        <ArrowLeft size={18} />\n                    </Link>\n                </Button>\n                <div>\n                    <div className=\"flex items-center gap-3\">\n                        <h1 className=\"text-3xl font-bold\">Pedido de Compra</h1>\n                        <Badge variant=\"outline\" className={\n                            pedido.status === 'ABERTO' ? 'bg-blue-500/5 text-blue-600 border-blue-200' :\n                                pedido.status === 'COTACAO' ? 'bg-amber-500/5 text-amber-600 border-amber-200' :\n                                    'bg-green-500/5 text-green-600 border-green-200'\n                        }>\n                            {pedido.status}\n                        </Badge>\n                    </div>\n                    <p className=\"text-muted-foreground flex items-center gap-3 mt-1\">\n                        <Calendar size={14} /> Aberto em {format(new Date(pedido.data_pedido), \"dd 'de' MMMM 'de' yyyy 'às' HH:mm\", { locale: ptBR })}\n                    </p>\n                </div>\n            </div>\n\n            <div className=\"grid gap-6 lg:grid-cols-3\">\n                {/* Coluna Esquerda: Itens e Cotações */}\n                <div className=\"lg:col-span-2 space-y-6\">\n                    {/* Itens */}\n                    <Card className=\"border-none shadow-sm bg-surface\">\n                        <CardHeader className=\"flex flex-row items-center justify-between\">\n                            <div>\n                                <CardTitle className=\"text-xl\">Itens Solicitados</CardTitle>\n                                <CardDescription>Produtos e insumos desta ordem.</CardDescription>\n                            </div>\n                            {pedido.status === 'ABERTO' && (\n                                <Dialog open={isAddItemOpen} onOpenChange={setIsAddItemOpen}>\n                                    <DialogTrigger>\n                                   