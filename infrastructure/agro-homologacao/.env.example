# Modelo apenas. O script `labctl prepare` gera os envs descartáveis com segredos.
# Não preencher com cópias de .env.local/.env.production nem credenciais reais.
ENVIRONMENT=staging
APP_ENV=staging
DATABASE_URL=postgresql+asyncpg://<user>:<password>@127.0.0.1:5433/<database>
REDIS_URL=redis://:<password>@127.0.0.1:6380/0
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/tmp/deepfarms-agro-hml-<instance-id>/uploads
JWT_SECRET_KEY=<synthetic-secret>
PLATFORM_CREDENTIALS_MASTER_KEY=<synthetic-fernet-key>
INTEGRATIONS_SECRET_KEY=<synthetic-secret>
BACKEND_URL=http://127.0.0.1:8001
AGRO_API_INTERNAL_ORIGIN=http://127.0.0.1:8001
