# ==============================================================================
# DeepFarms Agro — Modelo de Configuração de Staging (.env.staging.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.staging (este arquivo NUNCA deve ser commitado).
# 2. Gere segredos criptograficamente aleatórios com openssl rand -hex 32.
# 3. O script scripts/staging/validate_isolation.py valida este arquivo antes do boot.
# ==============================================================================

# Identificação do Ambiente
ENVIRONMENT=staging
APP_ENV=staging

# Banco de Dados Dedicado Staging (PostgreSQL 16)
STAGING_DB_USER=staging_agro
STAGING_DB_PASSWORD=gerar_com_openssl_rand_hex_24
STAGING_DB_NAME=deepfarms_agro_staging
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=5433

# Cache e Sessões Dedicado Staging (Redis 7)
STAGING_REDIS_PASSWORD=gerar_com_openssl_rand_hex_24
STAGING_REDIS_HOST=127.0.0.1
STAGING_REDIS_PORT=6380

# Chaves Criptográficas Obrigatórias (Mínimo de 32 caracteres)
STAGING_JWT_SECRET_KEY=gerar_com_openssl_rand_hex_32
STAGING_PLATFORM_CREDENTIALS_MASTER_KEY=gerar_com_openssl_rand_hex_32
STAGING_INTEGRATIONS_SECRET_KEY=gerar_com_openssl_rand_hex_32

# Storage Local MinIO (Isolado de S3 Produção)
STAGING_MINIO_USER=staging_minio_admin
STAGING_MINIO_PASSWORD=gerar_com_openssl_rand_hex_24
STAGING_MINIO_PORT=9002
STAGING_MINIO_CONSOLE_PORT=9003

# Portas de Acesso Local (Binding 127.0.0.1)
STAGING_API_WORKER_1_PORT=8001
STAGING_API_WORKER_2_PORT=8002
STAGING_WEB_PORT=3001
STAGING_AGRO_PORT=3005
